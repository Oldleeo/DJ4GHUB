<Window x:Class="DJ4Hub.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="老李 DJ4GHUB" Width="1280" Height="820" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F1F4FA" Icon="Assets/dj-4g-hub-icon.png"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="12" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#63748C" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChromeSurface" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ChromeSurface" Property="BorderBrush" Value="#8AA4C9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E3EAF5" />
          <Setter Property="Foreground" Value="#27384E" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#D7E1F0" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FCE6E8" />
          <Setter Property="Foreground" Value="#BD4457" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- WindowChrome delegates drag, caption double-click and resizing to Windows.
         Keep WebView2 in an opaque, hardware-accelerated HWND, not a layered window. -->
    <!-- Native controls are a startup/error fallback only. Once ready, the
         full-window WebView paints its own transparent caption and controls. -->
    <Grid Grid.Row="0" x:Name="ChromeTitleBar" Background="Transparent"
          Visibility="{Binding Visibility, ElementName=StartupPanel}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="ChromeDragRegion" Background="Transparent" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
        <Button x:Name="ChromeMinimizeButton" Style="{StaticResource ChromeButton}" Click="ChromeMinimize_Click"
                ToolTip="最小化" AutomationProperties.Name="最小化">
          <Path Width="12" Height="12" Stretch="None" Data="M 0,8 L 12,8" StrokeThickness="1.5"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="ChromeMaximizeButton" Style="{StaticResource ChromeButton}" Click="ChromeMaximize_Click"
                ToolTip="最大化" AutomationProperties.Name="最大化">
          <Path Width="13" Height="13" StrokeThickness="1.4" StrokeLineJoin="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
            <Path.Style>
              <Style TargetType="Path">
                <Setter Property="Data" Value="M 1,1 L 12,1 L 12,12 L 1,12 Z" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Data" Value="M 1,4 L 9,4 L 9,12 L 1,12 Z M 4,4 L 4,1 L 12,1 L 12,9 L 9,9" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
        </Button>
        <Button x:Name="ChromeCloseButton" Style="{StaticResource ChromeCloseButton}" Click="ChromeClose_Click"
                ToolTip="关闭到托盘，云端同步继续运行" AutomationProperties.Name="关闭到托盘">
          <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="0" Grid.RowSpan="2">
      <wv2:WebView2 x:Name="Browser" Visibility="Hidden" />
      <Border x:Name="StartupPanel" Background="Transparent" Margin="0,40,0,0">
        <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar x:Name="StartupProgress" Height="4" IsIndeterminate="True" Foreground="{StaticResource BrandBrush}" />
          <TextBlock x:Name="StartupTitle" Text="正在准备 DJ4GHUB" FontSize="25" FontWeight="SemiBold" Margin="0,24,0,10" TextAlignment="Center" />
          <TextBlock x:Name="StartupDetail" Text="正在启动只监听本机的安全后台…" Foreground="#64726E" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
